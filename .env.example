# Public Sanity project configuration (required)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=

# Optional: overrides the API version in src/sanity/env.ts
# NEXT_PUBLIC_SANITY_API_VERSION=2026-02-19

# Required only by scripts/*.mjs (dataset write access). Never expose publicly.
SANITY_API_TOKEN=

# Optional: override the local folder used by scripts/update-interiors-projects.mjs
# CLIENT_ASSETS_DIR=
